# Database & Authentication
MONGO_URI=
JWT_SECRET=

# AI Provider Selection: "ollama" | "gemini" | "openrouter" (default: gemini)
AI_PROVIDER=gemini

# Ollama Configuration (Local or Remote / Colab Tunnel)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_MS=90000

# Gemini Configuration (Default Provider / Fallback 1)
GEMINI_API_KEY=

# OpenRouter Configuration (Fallback 2)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Global Request Timeout
AI_REQUEST_TIMEOUT_MS=60000

# Judge0 Code Execution (Stage 2 — not required yet)
# Self-hosted: http://localhost:3308  |  RapidAPI free tier: https://judge0-ce.p.rapidapi.com
JUDGE0_BASE_URL=http://localhost:3308
JUDGE0_API_KEY=
